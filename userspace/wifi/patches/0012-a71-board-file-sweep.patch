 			snprintf(bdf_path, sizeof(bdf_path), BDF_DIR "bdwlan.b%02x", wlfw.board_id);
 		else
 			snprintf(bdf_path, sizeof(bdf_path), BDF_DIR "bdwlan.%03x", wlfw.board_id & 0xfff);
+		/*
+		 * A71 (0012): /var/local/wlan-bdf-sweep holds an index. This boot sends the index-th bdwlan.* of BDF_DIR
+		 * (sorted), and the file is advanced before the download, so a crash moves on too. radio.c restarts the
+		 * phone after a failed vdev start and ends the sweep after a good one or past the last file.
+		 */
+		{
+			FILE *sf = fopen("/var/local/wlan-bdf-sweep", "r");
+			unsigned idx = 0;
+			if (sf) {
+				if (fscanf(sf, "%u", &idx) != 1)
+					idx = 0;
+				fclose(sf);
+				static char names[64][32];
+				unsigned n = 0;
+				DIR *dir = opendir(BDF_DIR);
+				struct dirent *e;
+				while (dir && (e = readdir(dir)) && n < 64)
+					if (!strncmp(e->d_name, "bdwlan.", 7) && strlen(e->d_name) < 32)
+						strcpy(names[n++], e->d_name);
+				if (dir)
+					closedir(dir);
+				qsort(names, n, sizeof(names[0]), (int (*)(const void *, const void *))strcmp);
+				if (idx >= n) {
+					printf("wlfw: sweep: past the last of %u board files, sweep over\n", n);
+					unlink("/var/local/wlan-bdf-sweep");
+					unlink("/var/local/wlan-steps.conf");
+					sync();
+				} else {
+					snprintf(bdf_path, sizeof(bdf_path), BDF_DIR "%s", names[idx]);
+					snprintf(wlfw_sweep_name, sizeof(wlfw_sweep_name), "%s", names[idx]);
+					int fd = open("/var/local/wlan-bdf-sweep", O_WRONLY | O_TRUNC);
+					char b[16];
+					int bl = snprintf(b, sizeof(b), "%u\n", idx + 1);
+					int okw = fd >= 0 && write(fd, b, (size_t)bl) == bl && fcntl(fd, F_FULLFSYNC) != -1;
+					if (fd >= 0)
+						close(fd);
+					sync();
+					wlfw_sweep_armed = okw;
+					printf("wlfw: sweep: board file %u of %u: %s (next index %s)\n", idx + 1, n, names[idx],
+					       okw ? "saved" : "NOT saved: no restart");
+				}
+			}
+		}
 		const struct { const char *path; int file_id, type; unsigned seg; } v[] = {
 			{ bdf_path, 0, -1, 6144 },
 		};
