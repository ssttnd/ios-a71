diff --git a/phone/wifi/wland.c b/phone/wifi/wland.c
--- a/phone/wifi/wland.c
+++ b/phone/wifi/wland.c
@@ -607,13 +607,50 @@
  * Join after the first scan and stay joined: a failed try again after 5 s (4 times), then every 30 s with a
  * fresh scan first; a lost link (deauth, kickout, beacon miss) joins again after 3 s.
  */
+/*
+ * A71 (0027): the network iOS joined from Settings is kept like a wlan.conf one (in memory and in
+ * /var/local/wlan.conf, root only), so a lost link (beacon miss, 2026-11-07) and the next boot join it again;
+ * wifid's own auto-join does not happen here. A leave from wifid (Wi-Fi off, Forget) stops it for this boot.
+ */
+static int conf_from_ios;
+void wland_remember(const char *ssid, const char *pass)
+{
+	if (!strcmp(conf_ssid, ssid) && !strcmp(conf_psk, pass) && conf_from_ios)
+		return;
+	snprintf(conf_ssid, sizeof(conf_ssid), "%s", ssid);
+	snprintf(conf_psk, sizeof(conf_psk), "%s", pass);
+	conf_from_ios = 1;
+	int fd = open(WLAN_CONF, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd >= 0) {
+		dprintf(fd, "ssid=%s\npsk=%s\n", ssid, pass);
+		close(fd);
+	}
+	printf("net: remembered '%s' for rejoins and the next boot\n", ssid);
+}
+
+void wland_forget_for_now(void)
+{
+	if (conf_ssid[0])
+		printf("net: wifid left '%s': no rejoins this boot\n", conf_ssid);
+	conf_ssid[0] = 0;
+}
