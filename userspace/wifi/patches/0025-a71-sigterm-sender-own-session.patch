+/* A71 (0025): wave26 ended by SIGTERM about a minute into a busy link, parent and child alike. Say who sent it, live on. */
+static void on_term(int sig, siginfo_t *si, void *ctx)
+{
+	(void)ctx;
+	char m[96];
+	int n = snprintf(m, sizeof(m), "wland: signal %d from pid %d (uid %d), ignored\n", sig, si ? (int)si->si_pid : -1,
+			 si ? (int)si->si_uid : -1);
+	if (n > 0)
+		write(1, m, (size_t)n);
+}
+
+static void keep_on_term(void)
+{
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = on_term;
+	sa.sa_flags = SA_SIGINFO | SA_RESTART;
+	sigemptyset(&sa.sa_mask);
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGHUP, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
+}
+
