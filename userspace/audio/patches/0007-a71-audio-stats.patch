+/* A71: one line per 100 pulls while there is sound */
+static struct { uint32_t pulls, partial, empty, lmin, lmax, omin, bmax; int active; } af_st;
+static void af_stat(uint32_t lvl, uint32_t got, int sound)
+{
+	if (!af_st.pulls || lvl < af_st.lmin)
+		af_st.lmin = lvl;
+	if (lvl > af_st.lmax)
+		af_st.lmax = lvl;
+	if (!af_st.pulls || pcm_out < af_st.omin)
+		af_st.omin = pcm_out;
+	if (!got)
+		af_st.empty++;
+	else if (got < PCM_FRAMES)
+		af_st.partial++;
+	af_st.active |= sound != 0;
+	if (++af_st.pulls < 100)
+		return;
+	if (af_st.active)
+		printf("audio: 100 pulls: %u partial, %u empty, ring %u..%u, at DSP min %u, burst max %u, held now %u\n",
+		       af_st.partial, af_st.empty, af_st.lmin, af_st.lmax, af_st.omin, af_st.bmax, af_nheld);
+	memset(&af_st, 0, sizeof(af_st));
+}
 
