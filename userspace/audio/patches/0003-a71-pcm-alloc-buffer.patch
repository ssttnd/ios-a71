diff --git a/phone/wifi/adspboot.c b/phone/wifi/adspboot.c
--- a/phone/wifi/adspboot.c
+++ b/phone/wifi/adspboot.c
@@ -134,11 +134,22 @@
 {
 	uint16_t sids[1] = { (uint16_t)pcm_sid };
 	if (pcm_fixed) {
-		/* A71: below 4 GB = SID 0x1b20, which the kernel (xnu 0211) routes through a translation-off bank at
-		 * boot: the DSP's address is the physical one, and the apps SMMU is not touched from here */
-		pcm_pa = pcm_dsp = pcm_fixed;
+		/* A71: the kernel (xnu 0211/0213) routes SID 0x1b21 through a translation-off bank at boot, and the
+		 * apps SMMU is not touched from here. Bits 35:32 of the DSP's address pick the stream, so with
+		 * --pcm-pa alloc the buffer must lie at 0x1xxxxxxxx: then it is its own DSP address. */
 		if (rec_on)
 			pcm_buf_len = PCM_BUF + REC_READS * REC_BYTES;
+		if (pcm_fixed == 1) {
+			uint64_t pa = pm_alloc(pcm_buf_len, 0x1000);
+			if (!pa || (pa >> 32) != 1) {
+				printf("pcm: buffer %llx is not at 0x1xxxxxxxx: its address would pick another stream\n",
+				       (unsigned long long)pa);
+				return 1;
+			}
+			pcm_pa = pcm_dsp = pa;
+		} else {
+			pcm_pa = pcm_dsp = pcm_fixed;
+		}
 		printf("pcm: fixed buffer pa %llx (%u B) = DSP address (identity bank from the kernel, SMMU untouched)\n",
 		       (unsigned long long)pcm_pa, pcm_buf_len);
 		return 0;
@@ -3492,7 +3503,7 @@
 		else if (!strcmp(argv[i], "--vote-block") && i + 1 < argc)	/* sp2b: hw_block_id of the vote */
 			vote_block = (uint32_t)strtoul(argv[++i], NULL, 0);
 		else if (!strcmp(argv[i], "--pcm-pa") && i + 1 < argc)	/* A71 0002 */
-			pcm_fixed = strtoull(argv[++i], NULL, 0) & ~0xfffull;
+			pcm_fixed = !strcmp(argv[i + 1], "alloc") ? (i++, 1) : strtoull(argv[++i], NULL, 0) & ~0xfffull;
 		else if (!strcmp(argv[i], "--pcm"))	/* ap6: ASM + ADM PCM to the AFE port, amps untouched; implies --afe */
 			apr_on = afe_on = pcm_on = smmu = 1;
 		else if (!strcmp(argv[i], "--amp"))	/* sp1: left amp on for the --pcm tone; implies --pcm */
