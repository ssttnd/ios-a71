+/* CHG_STATUS0, low three bits: 3 or 5 is good power on CHGIN (s2mu106_charger.c). -1: not read. */
+int
+sweet_a71_cable_in(void)
+{
+	uint8_t s = 0;
+	if (sweet_a71_i2c_read(42, 43, 0x3d, 0x0e, &s, 1)) {
+		return -1;
+	}
+	return (s & 7) == 3 || (s & 7) == 5;
+}
+
+/*
+ * 0201, sweetcharge=MA. The boot chain leaves 500 mA on the input (CTRL2 0x1a = 0x12) and 500 mA into
+ * the battery (CTRL7 0x1f = 0x09), and nothing here negotiates more, so iOS under load drains on a
+ * cable. Same encodings as Samsung's driver: input (mA - 125) / 25 + 3, battery mA / 50 - 1. The
+ * charger still limits itself on a weak source. There is no temperature watch here, so the battery
+ * current stays low: input at most 1800 mA, battery at most 1500 mA.
+ */
+void
+sweet_a71_charge_set(unsigned ma)
+{
+	if (ma < 500) {
+		return;
+	}
+	const unsigned in = ma > 1800 ? 1800 : ma, bat = ma > 1500 ? 1500 : ma;
+	uint8_t r2 = 0, r7 = 0;
+	int err = sweet_a71_i2c_read(42, 43, 0x3d, 0x1a, &r2, 1);
+	err = err ? err : sweet_a71_i2c_read(42, 43, 0x3d, 0x1f, &r7, 1);
+	if (err) {
+		printf("SWEET CHARGE: read errno=%d\n", err);
+		return;
+	}
+	const uint8_t n2 = (uint8_t)((r2 & 0x80) | (((in - 125) / 25 + 3) & 0x7f));
+	const uint8_t n7 = (uint8_t)((r7 & 0xc0) | ((bat / 50 - 1) & 0x3f));
+	if (n2 == r2 && n7 == r7) {
+		return;
+	}
+	err = a71_i2c_write(42, 43, 0x3d, 0x1a, n2);
+	err = err ? err : a71_i2c_write(42, 43, 0x3d, 0x1f, n7);
+	printf("SWEET CHARGE: input %u mA, battery %u mA: 0x1a %02x->%02x 0x1f %02x->%02x errno=%d\n",
+	    in, bat, r2, n2, r7, n7, err);
+}
+
