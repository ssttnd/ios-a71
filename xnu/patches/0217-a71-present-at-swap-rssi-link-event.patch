--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1018,6 +1018,23 @@
 	IOLockUnlock(fLock);
 	__atomic_add_fetch(&fStatsSwaps, 1, __ATOMIC_RELAXED);
 	sweet_sched_tap_event(0);
+	/*
+	 * 0217: start the present now, not at the next timer tick. The frame sat here for up to 16.7 ms before the present
+	 * thread even began to wait for its fence, and with sweetswapwait CoreAnimation waits for that present: 30 frames
+	 * a second whatever the GPU clock (650 and 700 MHz measured the same). sweetpresentswap=0: back to the tick.
+	 */
+	{
+		static int at_swap = -1;
+		if (at_swap < 0) {
+			int v = 1;
+			PE_parse_boot_argn("sweetpresentswap", &v, sizeof(v));
+			at_swap = v != 0;
+			IOLog("SWEET FB: present %s\n", at_swap ? "at SwapEnd" : "at the vsync tick");
+		}
+		if (at_swap && fPresentThreaded) {
+			requestPresent();
+		}
+	}
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
