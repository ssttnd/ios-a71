+					lq_last = state->bss.rssi;
+					printf("apple80211: link event for rssi %d\n", state->bss.rssi);
+					post(EVENT_LINK_CHANGED, &lq, sizeof(lq));
+				}
 				static unsigned lq_said;
 				if (lq_said < 20) {
 					lq_said++;
