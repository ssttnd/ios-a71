+/*
+ * 0200: sweetpaneloff=1 sends DCS display off (0x28) when the fade has ended and display on (0x29)
+ * before the next frame. Same engine as the brightness write above: a short write, data id 0x05.
+ */
+extern "C" void sweet_panel_power(int on);
+extern "C" void
+sweet_panel_power(int on)
+{
+	static int enabled = -1;
+	static volatile uint32_t *dsi;
+	if (enabled < 0) {
+		int v = 0;
+		PE_parse_boot_argn("sweetpaneloff", &v, sizeof(v));
+		enabled = v;
+		if (enabled) {
+			dsi = (volatile uint32_t *)ml_io_map(SWEET_DSI0_PA, 0x400);
+		}
+	}
+	if (!enabled || dsi == NULL) {
+		return;
+	}
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4], dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	const uint32_t word = (on ? 0x29u : 0x28u) | (0x05u << 16) | (0x80u << 24);
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = word;
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30))) | (1u << 26) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = sizeof(word);
+	__asm__ volatile("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	IOLog("SWEET PANEL: DCS %#x %s after %u us ack_err=%#x\n", on ? 0x29u : 0x28u,
+	    done ? "sent" : "NOT acknowledged", us, dsi[DSI_REG_ACK_ERR / 4]);
+}
