+/*
+ * Calendar from the PM6150 RTC (seconds at 0x6048-0x604b, enable 0x6046 bit 7, as
+ * Linux rtc-pm8xxx; from DC28088/ios-sweet 0166). The A71's RTC does not hold the
+ * real date: Android keeps an offset in its own data. So the boot image carries
+ * sweetrtcoffset=N (PC time minus RTC, computed when it is flashed). Without an
+ * offset the calendar is only set from an RTC that already looks like a real date.
+ * iOS on a calendar of 1969 misbehaves widely.
+ */
+static void
+sweetSetCalendarFromRtc(void)
+{
+	clock_sec_t now = 0;
+	clock_usec_t us = 0;
+	clock_get_calendar_microtime(&now, &us);
+	if (now > 978307200) {
+		return;
+	}
+	uint64_t offset = 0;
+	(void)PE_parse_boot_argn("sweetrtcoffset", &offset, sizeof(offset));
+	uint8_t ctl = 0, b[4], low = 0;
+	if (sweet_spmi_read(0, 0x6046, &ctl) || !(ctl & 0x80u)) {
+		IOLog("SWEET RTC: PM6150 RTC not readable or disabled (ctl %#x)\n", ctl);
+		return;
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		bool ok = true;
+		for (unsigned i = 0; i < 4 && ok; i++) {
+			ok = !sweet_spmi_read(0, 0x6048 + i, &b[i]);
+		}
+		if (!ok || sweet_spmi_read(0, 0x6048, &low)) {
+			IOLog("SWEET RTC: PM6150 RTC read failed\n");
+			return;
+		}
+		if (low == b[0]) {
+			const uint32_t secs = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+			const uint64_t real = (uint64_t)secs + offset;
+			if (real < 978307200ULL) {
+				IOLog("SWEET RTC: RTC %u s + offset %llu is before 2001; calendar left alone\n", secs, offset);
+				return;
+			}
+			clock_set_calendar_microtime((clock_sec_t)real, 0);
+			IOLog("SWEET RTC: calendar set: RTC %u s + offset %llu = %llu\n", secs, offset, real);
+			return;
+		}
+	}
+	IOLog("SWEET RTC: PM6150 RTC kept moving while read\n");
+}
