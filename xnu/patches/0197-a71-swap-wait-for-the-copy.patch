--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -240,6 +240,8 @@
 	/* 0131 hardware: presents averaged 15-66ms (max 247ms) once submits were
 	 * cheap; split them so the remaining cap is measured. */
 	uint64_t      fStatsGateUs, fStatsAcquireUs, fStatsCopyUs, fStatsSwaps;
+	uint32_t      fPresentedSwap; /* 0197: swap id of the last frame copied to the panel */
+	bool          fPresentCopying;
 	uint32_t      fPendingFence, fPresentFence;   /* newest GPU fence when SwapEnd recorded the frame */
 	/* Beam-raced copy (0144): the DSC video-mode panel scans this single
 	 * buffer continuously, so a copy that starts behind the scan line tears
@@ -849,6 +851,11 @@
 		}
 		const uint64_t began = mach_absolute_time();
 		fb->present(fb->fPresentRec);
+		{
+			uint32_t done;
+			memcpy(&done, fb->fPresentRec + 0x50, sizeof(done));
+			__atomic_store_n(&fb->fPresentedSwap, done, __ATOMIC_RELEASE);
+		}
 		uint64_t ns = 0;
 		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
 		const uint64_t us = ns / NSEC_PER_USEC;
@@ -1691,7 +1698,39 @@
 			IOLog("SWEET FB: display %s\n", off ? "off" : "on");
 		}
 		break;
-	case kSweetFBSwapWait:
+	case kSweetFBSwapWait: {
+		/* 0197: CoreAnimation asks here whether a swap is on the panel and then reuses its
+		 * surface. Answering at once let it redraw a surface while the present thread copied
+		 * it: chaotic artifacts under load, until sweetpresentlock drained the whole GPU for
+		 * every copy. Wait for the copy instead, bounded so a stopped display cannot hang it. */
+		static int on = -1;
+		if (on < 0) {
+			int v = 0;
+			PE_parse_boot_argn("sweetswapwait", &v, sizeof(v));
+			on = v;
+		}
+		const uint32_t want = args->scalarInputCount >= 1 ? (uint32_t)args->scalarInput[0] : 0;
+		if (on && want != 0) {
+			static unsigned logged;
+			if (logged < 4) {
+				logged++;
+				IOLog("SWEET FB: SwapWait inputs %u: %llu %llu %llu\n", args->scalarInputCount,
+				    args->scalarInputCount > 0 ? args->scalarInput[0] : 0,
+				    args->scalarInputCount > 1 ? args->scalarInput[1] : 0,
+				    args->scalarInputCount > 2 ? args->scalarInput[2] : 0);
+			}
+			const uint64_t began = mach_absolute_time();
+			uint64_t ns = 0;
+			while (!fFB->fPowerOff && (int32_t)(__atomic_load_n(&fFB->fPresentedSwap, __ATOMIC_ACQUIRE) - want) < 0) {
+				absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+				if (ns >= 40000000ULL) {
+					break;
+				}
+				IOSleep(1);
+			}
+		}
+		break;
+	}
 	default:
 		break;
 	}
