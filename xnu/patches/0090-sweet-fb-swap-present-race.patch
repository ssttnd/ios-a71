 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+/*
+ * Read-only: how ABL left the display engine. The A71's S6E3FA9 is a command-mode
+ * panel (DT dsi_cmd_mode), unlike the video-mode Redmi and Pixel panels, so the INTF
+ * line counter their tear fix uses may not run. Offsets from the A71 live DT
+ * (sde-pp-off, sde-intf-off, sde-sspp-off) and Linux dpu_hw_pingpong.c. Own thread:
+ * a stalled read must not stop the display. sweetfbprobe=0 turns it off.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static void
+sweet_mdp_probe(void *arg __unused, wait_result_t wr __unused)
+{
+	int on = 1;
+	PE_parse_boot_argn("sweetfbprobe", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	IOSleep(15000);
+	vm_offset_t mdp = ml_io_map(0x0ae00000, 0x84208);
+	if (mdp == 0) {
+		IOLog("SWEET FB: MDP map failed\n");
+		return;
+	}
+#define MDP_RD(off) (*(volatile uint32_t *)(mdp + (off)))
+	static const uint32_t pp[] = { 0x71000, 0x71800 };
+	static const uint32_t intf[] = { 0x6b800, 0x6c000 };
+	static const uint32_t sspp[] = { 0x5000, 0x7000, 0x25000, 0x27000, 0x29000 };
+	for (unsigned i = 0; i < 2; i++) {
+		IOLog("SWEET FB: INTF_%u next\n", i + 1);
+		IOLog("SWEET FB: INTF_%u en=%#x hsync_ctl=%#x vsync_period=%#x\n", i + 1, MDP_RD(intf[i]),
+		    MDP_RD(intf[i] + 0x8), MDP_RD(intf[i] + 0xc));
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		IOLog("SWEET FB: PP_%u next\n", i);
+		const uint32_t b = pp[i];
+		IOLog("SWEET FB: PP_%u tear_en=%#x sync_cfg=%#x height=%#x thresh=%#x start=%#x autorefresh=%#x line=%#x\n", i,
+		    MDP_RD(b), MDP_RD(b + 0x4), MDP_RD(b + 0x8), MDP_RD(b + 0x18), MDP_RD(b + 0x1c), MDP_RD(b + 0x30), MDP_RD(b + 0x2c));
+		for (unsigned s = 0; s < 8; s++) {
+			IOLog("SWEET FB: PP_%u sample %u int_count=%#x line=%#x\n", i, s, MDP_RD(b + 0x14), MDP_RD(b + 0x2c));
+			IODelay(2500);
+		}
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		IOLog("SWEET FB: SSPP_%u src0=%#x\n", i, MDP_RD(sspp[i] + 0x14));
+	}
+#undef MDP_RD
+}
