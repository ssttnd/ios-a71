+
+/*
+ * Bus (BCM) vote from the kernel. Command: commit|valid|x<<14|y, as Linux's
+ * BCM_TCS_CMD. From DC28088/ios-sweet 0149/0169; only the listed BCMs.
+ * SN15/CN0: the path to the apps SMMU and config space, small levels only.
+ * MC0/SH0/ACV: the memory.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
+{
+	const bool memory = res && (!strcmp(res, "MC0") || !strcmp(res, "SH0") || !strcmp(res, "ACV"));
+	if (!res || (strcmp(res, "SN15") && strcmp(res, "CN0") && !memory) ||
+	    x > (memory ? 0x3fffu : 16u) || y > (memory ? 0x3fffu : 16u) || (!x && !y)) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup_slave(res, RH_BCM, &address);
+		}
+		if (!error) {
+			const uint32_t value = 1u << 30 | 1u << 29 | x << 14 | y;
+			error = rh_send_arc(address, value);
+			printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, address, value, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Memory bandwidth. Nothing here voted for DRAM, which may have left it at the
+ * bootloader's rate (DC28088/ios-sweet 0169 measured a large gain on Redmi).
+ * sweetddr=0: no vote; sweetddrvote=N: N instead of 0x3fff.
+ */
+void sweet_rpmh_ddr_raise(void);
+void
+sweet_rpmh_ddr_raise(void)
+{
+	uint32_t on = 1, vote = 0x3fff;
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	PE_parse_boot_argn("sweetddrvote", &vote, sizeof(vote));
+	if (!on || vote == 0 || vote > 0x3fff) {
+		printf("SWEET DDR: no memory bandwidth vote (sweetddr=%u, vote %u)\n", on, vote);
+		return;
+	}
+	const int mc0 = sweet_rpmh_bcm_vote("MC0", vote, vote);
+	const int sh0 = sweet_rpmh_bcm_vote("SH0", vote, vote);
+	const int acv = sweet_rpmh_bcm_vote("ACV", 0, 8);
+	printf("SWEET DDR: memory bandwidth vote %u: MC0 %d, SH0 %d, ACV %d\n", vote, mc0, sh0, acv);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
