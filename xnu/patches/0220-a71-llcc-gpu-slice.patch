 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/*
+ * 0220: the GPU data slice of the system cache (sdmmagpie table: id 12, 256 KB, priority 1, fixed, bonus ways 0xf; A71 DT
+ * cache-slices agrees). Registers are open to the kernel: read and written through /dev/pmem on 2026-11-08. A618 takes the
+ * CX_MISC path: SCID 12 in all five clients of CNTL_1, CNTL_0 = 3 to override write-no-alloc. sweetllcc=0 leaves it off.
+ * The page-table walker slice (11) stays off: our tables are written non-cacheable.
+ */
+static void
+sweet_llcc_gpu_enable(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetllcc", &on, sizeof(on));
+	if (!on) {
+		printf("SWEET ADRENO: LLCC off (sweetllcc=0)\n");
+		return;
+	}
+	vm_offset_t bcast = ml_io_map(0x09600000, 0x22000);
+	vm_offset_t bank0 = ml_io_map(0x09200000, 0x22000);
+	vm_offset_t misc = ml_io_map(0x0509e000, 0x1000);
+	if (!bcast || !bank0 || !misc) {
+		printf("SWEET ADRENO: LLCC map failed\n");
+		return;
+	}
+#define LL_W(off, v) (*(volatile uint32_t *)(bcast + (off)) = (v))
+#define LL_R(off) (*(volatile uint32_t *)(bank0 + (off)))
+#define MISC(off) (*(volatile uint32_t *)(misc + (off)))
+	LL_W(0x21064, 0x08000018);	/* ATTR1: 256 KB over 2 banks, priority 1, fixed */
+	LL_W(0x21060, 0x000f0000);	/* ATTR0: bonus ways 0xf */
+	LL_W(0x21f00, LL_R(0x21f00) & ~(1u << 12));	/* capacity-based allocation on for this slice */
+	__builtin_arm_dsb(0xf);
+	LL_W(0xc000, 3);
+	__builtin_arm_dsb(0xf);
+	LL_W(0xc000, 2);
+	__builtin_arm_dsb(0xf);
+	unsigned tries = 0;
+	while ((LL_R(0xc004) & 2) && tries++ < 100)
+		delay(1);
+	const uint32_t status = LL_R(0xc004);
+	MISC(0x8) = (MISC(0x8) & ~0x01ffffffu) | 0x00c6318cu;
+	MISC(0x4) = 3;
+	__builtin_arm_dsb(0xf);
+	printf("SWEET ADRENO: LLCC GPU slice 12 status=%#x attr %#x %#x cad %#x cx_misc %#x %#x\n", status,
+	    LL_R(0x21060), LL_R(0x21064), LL_R(0x21f00), MISC(0x4), MISC(0x8));
+#undef LL_W
+#undef LL_R
+#undef MISC
+}
