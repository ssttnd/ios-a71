 	const unsigned soc = (unsigned)d[4] | ((unsigned)d[5] << 8);
 	*mv = (unsigned)((uint64_t)volt * 1000u / 8192u);
 	*ma = (int)(-(int64_t)cur * 1000 / 4096);
-	/* In tenths of a percent, over capacity_max (990 in the device tree), rounded. */
-	unsigned pct = (unsigned)(((uint64_t)soc * 1000u / 16384u * 100u / 990u + 5u) / 10u);
+	/* Over capacity_max (990, that is 99.0%, in the device tree), rounded. 0x13ad: 30.7 -> 31. */
+	unsigned pct = (unsigned)(((uint64_t)soc * 1000u / 16384u * 1000u / 990u + 5u) / 10u);
 	*percent = pct > 100 ? 100 : pct;
