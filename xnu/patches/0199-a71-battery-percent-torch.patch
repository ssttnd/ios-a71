+
+static int
+a71_i2c_write(unsigned sda, unsigned scl, unsigned addr, unsigned reg, uint8_t value)
+{
+	int err = 0;
+	lck_mtx_lock(&a71_lock);
+	if (a71_north == 0) {
+		a71_north = ml_io_map(A71_TLMM_NORTH_PA, A71_TLMM_NORTH_LEN);
+	}
+	if (a71_north == 0) {
+		err = ENXIO;
+	} else {
+		a71_start(sda, scl);
+		if (!a71_put(sda, scl, (uint8_t)(addr << 1)) || !a71_put(sda, scl, (uint8_t)reg) || !a71_put(sda, scl, value)) {
+			err = EIO;
+		}
+		a71_stop(sda, scl);
+	}
+	lck_mtx_unlock(&a71_lock);
+	return err;
+}
+
+/*
+ * The registers Samsung's driver changes for rear_torch_flash, read around it on this phone,
+ * at charger address 0x3d: 0x14 00->40, 0x15 00->0c, 0x54 fd->e1, back when it goes off.
+ * iOS's own flashlight button needs its camera stack, so this hangs on both volume keys.
+ */
+void
+sweet_a71_torch_toggle(void)
+{
+	static bool on;
+	static const uint8_t regs[3] = {0x14, 0x15, 0x54};
+	static const uint8_t lit[3] = {0x40, 0x0c, 0xe1}, dark[3] = {0x00, 0x00, 0xfd};
+	int err = 0;
+	on = !on;
+	for (unsigned i = 0; i < 3 && !err; i++) {
+		err = a71_i2c_write(42, 43, 0x3d, regs[i], on ? lit[i] : dark[i]);
+	}
+	printf("SWEET TORCH: %s errno=%d\n", on ? "on" : "off", err);
 }
 
