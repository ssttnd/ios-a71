+/*
+ * 0191: raw area just below the persistent log, written from TWRP by
+ * tools/a71-payload.py and read by the installer in bsd/dev/sweet_files.c.
+ */
+#define SWEET_PAYLOAD_BLOCKS    65536u  /* 256 MiB */
+
+int sweet_ufs_payload_read(uint32_t blk, uint32_t count, void *out);
+int sweet_ufs_payload_clear(void);
+
+int
+sweet_ufs_payload_read(uint32_t blk, uint32_t count, void *out)
+{
+	if (!su.ready || su.nblocks < 2 * (uint64_t)(SWEET_LOG_BLOCKS + SWEET_PAYLOAD_BLOCKS) ||
+	    blk >= SWEET_PAYLOAD_BLOCKS || count == 0 || count > SWEET_PAYLOAD_BLOCKS - blk ||
+	    count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - SWEET_PAYLOAD_BLOCKS;
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_read_blocks(base + blk, count);
+	if (!error) {
+		memcpy(out, (const void *)(su.dma + DMA_BOUNCE), (size_t)count * UFS_BLOCK);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+int
+sweet_ufs_payload_clear(void)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - SWEET_PAYLOAD_BLOCKS;
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+	int error = ufs_write_blocks(base, 1);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
