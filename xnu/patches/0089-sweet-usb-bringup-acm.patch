+/*
+ * Each step logs first, so that a stalled register access is visible as the last
+ * line of the persistent log. Own thread and late, after the root is mounted: a
+ * failure here must not stop iOS from booting. Sources: A71 live DT, Linux
+ * gcc-sdmmagpie.c, phy-msm-qusb-v2.c, dwc3-msm.c, dwc3 core.c.
+ */
+static void
+sweet_usb_bringup(void *arg __unused, wait_result_t wr __unused)
+{
+	/* QUSB2 init sequence from the A71 live DT: value, register */
+	static const uint16_t phy_seq[][2] = {
+		{ 0x23, 0x210 }, { 0x03, 0x004 }, { 0x7c, 0x18c }, { 0x80, 0x02c }, { 0x0a, 0x184 }, { 0x19, 0x0b4 },
+		{ 0x40, 0x194 }, { 0x1c, 0x198 }, { 0x21, 0x214 }, { 0x08, 0x220 }, { 0x58, 0x224 }, { 0x72, 0x240 },
+		{ 0x2b, 0x244 }, { 0xca, 0x248 }, { 0x02, 0x24c }, { 0x03, 0x250 }, { 0x30, 0x23c }, { 0x22, 0x210 },
+	};
+	/* usb_cbcr[] indexes in enable order: config path first, master before its users */
+	static const uint8_t order[] = { 3, 4, 5, 6, 0, 1, 2 };
+	int wait_ms = 8000, err;
+
+	PE_parse_boot_argn("sweetusbdelay", &wait_ms, sizeof(wait_ms));
+	ud_sleep_ms((unsigned)wait_ms);
+	ud.acm = true;
+	/* 115200 8N1 until the host says otherwise; the line ignores it */
+	ud.line_coding[0] = 0x00; ud.line_coding[1] = 0xc2; ud.line_coding[2] = 0x01; ud.line_coding[6] = 8;
+
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (!gcc || !qs || !phy || !dwc) {
+		printf("SWEET USB: map failed\n");
+		return;
+	}
+
+	printf("SWEET USB: bring-up: PHY rails\n");
+	for (int i = 0; (err = sweet_rpmh_usb_rails()) == EBUSY && i < 100; i++) {
+		ud_sleep_ms(50);
+	}
+	if (err) {
+		printf("SWEET USB: PHY rails failed (%d); stopping\n", err);
+		return;
+	}
+	const int sn = sweet_rpmh_bcm_vote("SN15", 1, 1), cn = sweet_rpmh_bcm_vote("CN0", 1, 1);
+	printf("SWEET USB: bus votes SN15=%d CN0=%d\n", sn, cn);
+	ud_sleep_ms(50);
+
+	printf("SWEET USB: TBU2 GDSC vote 0x%08x\n", usb_rd(gcc, GCC_TBU2_VOTE_GDSCR));
+	up_wr(gcc, GCC_TBU2_VOTE_GDSCR, usb_rd(gcc, GCC_TBU2_VOTE_GDSCR) & ~1u);
+	ud_sleep_ms(1);
+	printf("SWEET USB: TBU2 GDSC vote now 0x%08x\n", usb_rd(gcc, GCC_TBU2_VOTE_GDSCR));
+
+	printf("SWEET USB: USB GDSC 0x%08x, powering on\n", usb_rd(gcc, GCC_USB30_PRIM_GDSCR));
+	up_wr(gcc, GCC_USB30_PRIM_GDSCR, usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & ~1u);
+	int i;
+	for (i = 0; i < 500 && !(usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31)); i++) {
+		delay(10);
+	}
+	printf("SWEET USB: USB GDSC 0x%08x after %d0 us\n", usb_rd(gcc, GCC_USB30_PRIM_GDSCR), i);
+	if (!(usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31))) {
+		printf("SWEET USB: GDSC did not power on; stopping\n");
+		return;
+	}
+
+	/* Core block reset with its clocks off, as dwc3_msm_block_reset */
+	up_wr(gcc, GCC_USB30_PRIM_BCR, 1);
+	delay(1000);
+	up_wr(gcc, GCC_USB30_PRIM_BCR, 0);
+	delay(1000);
+
+	up_rcg(gcc, GCC_USB3_MASTER_RCGR, (1u << 8) | 8u, "master");   /* GPLL0 / 4.5 = 133 MHz, DT core-clk-rate */
+	up_rcg(gcc, GCC_USB3_UTMI_RCGR, 1u, "utmi");                    /* XO 19.2 MHz */
+	for (unsigned k = 0; k < sizeof(order); k++) {
+		if (!up_branch(gcc, order[k]) && (order[k] == 0 || order[k] == 3)) {
+			printf("SWEET USB: required clock stayed off; stopping\n");
+			return;
+		}
+	}
+	ud_sleep_ms(1);
+
+	int smmu = 1;
+	PE_parse_boot_argn("sweetusbsmmu", &smmu, sizeof(smmu));
+	if (smmu) {
+		(void)sweet_rpmh_bcm_vote("SN15", 1, 1);
+		(void)sweet_rpmh_bcm_vote("CN0", 1, 1);
+		ud_sleep_ms(1);
+		up_smmu_stream();
+	}
+
+	printf("SWEET USB: reading controller\n");
+	uint32_t id = usb_rd(dwc, 0xc120);
+	printf("SWEET USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GUSB2PHYCFG 0x%08x\n", id, usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc200));
+	if ((id >> 16) != 0x5533) {
+		printf("SWEET USB: not a DWC3 ID; stopping\n");
+		return;
+	}
+
+	/* Wrapper: RAM clock on; no SS PHY on this board, so UTMI clocks the pipe side. */
+	up_wr(qs, 0x28, usb_rd(qs, 0x28) | 0x18);
+	up_wr(qs, 0x08, usb_rd(qs, 0x08) | (1u << 8));                          /* PIPE_UTMI_CLK_DIS */
+	delay(100);
+	up_wr(qs, 0x08, usb_rd(qs, 0x08) | (1u << 0) | (1u << 3));              /* CLK_SEL, PHYSTATUS_SW */
+	delay(100);
+	up_wr(qs, 0x08, usb_rd(qs, 0x08) & ~(1u << 8));
+	printf("SWEET USB: QSCRATCH GENERAL_CFG 0x%08x CGCTL 0x%08x\n", usb_rd(qs, 0x08), usb_rd(qs, 0x28));
+
+	/* PHY: reset, then the DT sequence */
+	up_wr(gcc, GCC_QUSB2PHY_PRIM_BCR, 1);
+	delay(100);
+	up_wr(gcc, GCC_QUSB2PHY_PRIM_BCR, 0);
+	delay(100);
+	up_wr(phy, 0x210, usb_rd(phy, 0x210) | 1);
+	for (unsigned k = 0; k < sizeof(phy_seq) / sizeof(phy_seq[0]); k++) {
+		up_wr(phy, phy_seq[k][1], phy_seq[k][0]);
+	}
+	ud_sleep_ms(1);
+	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x (PLL %s)\n", usb_rd(phy, 0x1a0), usb_rd(phy, 0x210),
+	    (usb_rd(phy, 0x1a0) & 1) ? "ready" : "NOT READY");
+
+	/* Core soft reset, as dwc3_core_soft_reset */
+	up_wr(dwc, 0xc110, usb_rd(dwc, 0xc110) | (1u << 11));
+	up_wr(dwc, 0xc2c0, usb_rd(dwc, 0xc2c0) | (1u << 31));
+	up_wr(dwc, 0xc200, usb_rd(dwc, 0xc200) | (1u << 31));
+	ud_sleep_ms(100);
+	up_wr(dwc, 0xc2c0, usb_rd(dwc, 0xc2c0) & ~(1u << 31));
+	up_wr(dwc, 0xc200, usb_rd(dwc, 0xc200) & ~(1u << 31));
+	ud_sleep_ms(100);
+	up_wr(dwc, 0xc110, usb_rd(dwc, 0xc110) & ~(1u << 11));
+	/* GCTL: device mode, no scale-down, clock gating off (DT snps,disable-clk-gating) */
+	uint32_t gctl = usb_rd(dwc, 0xc110) & ~((3u << 12) | (3u << 4));
+	up_wr(dwc, 0xc110, gctl | (2u << 12) | 1u);
+	/* DT snps,dis_u2_susphy_quirk, dis_enblslpm_quirk; no U3 PHY suspend either */
+	up_wr(dwc, 0xc200, usb_rd(dwc, 0xc200) & ~((1u << 6) | (1u << 8)));
+	up_wr(dwc, 0xc2c0, usb_rd(dwc, 0xc2c0) & ~(1u << 17));
+	printf("SWEET USB: core ready: GCTL 0x%08x GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x GHWPARAMS3 0x%08x\n",
+	    usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc200), usb_rd(dwc, 0xc2c0), usb_rd(dwc, 0xc14c));
+
+	sweet_usb_gadget_start(dwc);
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
