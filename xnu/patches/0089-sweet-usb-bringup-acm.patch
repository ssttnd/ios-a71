+/* ---- sweetusb=3: bring the controller up from nothing (Samsung normal boot) ---- */
+
+extern int sweet_rpmh_usb_rails(void);
+extern int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+
+#define GCC_USB30_PRIM_BCR      0x0f000
+#define GCC_QUSB2PHY_PRIM_BCR   0x26000
+#define GCC_USB3_MASTER_RCGR    0x0f01c
+#define GCC_USB3_UTMI_RCGR      0x0f034
+#define GCC_TBU2_VOTE_GDSCR     0x7d038         /* DT hlos1_vote_aggre_noc_mmu_tbu2_gdsc */
+#define USB_SID                 0x540u          /* DT iommus: anoc_2_tbu */
+#define SMMU_PA                 0x15000000ULL
+
+static inline void
+up_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* Linux clk_rcg2: CFG at +4 (source << 8 | 2*div-1), then CMD.UPDATE. */
+static void
+up_rcg(vm_offset_t gcc, uint32_t rcgr, uint32_t cfg, const char *name)
+{
+	up_wr(gcc, rcgr + 4, cfg);
+	up_wr(gcc, rcgr, usb_rd(gcc, rcgr) | 1);
+	int i;
+	for (i = 0; i < 500 && (usb_rd(gcc, rcgr) & 1); i++) {
+		delay(1);
+	}
+	printf("SWEET USB: RCG %s CMD 0x%08x CFG 0x%08x after %d us\n", name, usb_rd(gcc, rcgr), usb_rd(gcc, rcgr + 4), i);
+}
+
+/* Returns false if the clock stayed off. */
+static bool
+up_branch(vm_offset_t gcc, unsigned idx)
+{
+	uint32_t off = usb_cbcr[idx].off;
+	up_wr(gcc, off, usb_rd(gcc, off) | 1);
+	int i;
+	for (i = 0; i < 500 && (usb_rd(gcc, off) & CBCR_CLK_OFF); i++) {
+		delay(1);
+	}
+	uint32_t v = usb_rd(gcc, off);
+	printf("SWEET USB: clk %-12s CBCR 0x%08x after %d us\n", usb_cbcr[idx].name, v, i);
+	return !(v & CBCR_CLK_OFF);
+}
+
+/*
+ * The USB stream through the apps SMMU with translation off, as Linux's
+ * qcom,smmu-s1-bypass. Same method as DC28088/ios-sweet 0153 for WLAN: lowest
+ * free SMR and a free context bank with SCTLR.M=0. Left alone when the SMMU is
+ * disabled, bypasses unmatched streams, or already has an entry for the stream.
+ */
+static void
+up_smmu_stream(void)
+{
+	volatile uint32_t *gr0 = (volatile uint32_t *)ml_io_map(SMMU_PA, 0x1000);
+	if (gr0 == NULL) {
+		printf("SWEET USB: SMMU map failed\n");
+		return;
+	}
+	printf("SWEET USB: reading apps SMMU\n");
+	const uint32_t scr0 = gr0[0], id0 = gr0[0x20 / 4], id1 = gr0[0x24 / 4];
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	printf("SWEET USB: SMMU sCR0 0x%08x ID0 0x%08x ID1 0x%08x: %u SMRs, %u banks\n", scr0, id0, id1, nsmr, ncb);
+	if (scr0 & 1) {
+		printf("SWEET USB: SMMU client port disabled: stream bypasses\n");
+		return;
+	}
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET USB: SMMU unexpected geometry; stream left alone\n");
+		return;
+	}
+	uint64_t used[2] = { 0, 0 };
+	int slot = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			if (slot < 0) {
+				slot = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		const uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if (((id ^ USB_SID) & ~mask & 0x7fff) == 0) {
+			printf("SWEET USB: SMMU SMR%u 0x%08x S2CR 0x%08x already matches the stream\n", i, smr, s2cr);
+			return;
+		}
+	}
+	if (!(scr0 & (1u << 10))) {
+		printf("SWEET USB: SMMU unmatched streams bypass; no entry needed\n");
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(SMMU_PA + psize, psize);
+	if (gr1 == NULL) {
+		return;
+	}
+	int cb = -1;
+	volatile uint32_t *cbp = NULL;
+	for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+		if ((used[c / 64] & (1ull << (c % 64))) || gr1[c] != 0) {
+			continue;
+		}
+		volatile uint32_t *page = (volatile uint32_t *)ml_io_map(SMMU_PA + (npage + c) * psize, psize);
+		if (page != NULL && !(page[0] & 1)) {
+			cb = (int)c;
+			cbp = page;
+		}
+	}
+	if (slot < 0 || cb < 0) {
+		printf("SWEET USB: SMMU no free SMR/bank (SMR %d, bank %d)\n", slot, cb);
+		return;
+	}
+	cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+	cbp[0x20 / 4] = 0;              /* TTBR0 */
+	cbp[0x24 / 4] = 0;
+	cbp[0x30 / 4] = 0;              /* TCR */
+	cbp[0x10 / 4] = 0;              /* TCR2 */
+	cbp[0x38 / 4] = 0;              /* MAIR */
+	cbp[0x3c / 4] = 0;
+	gr1[(0x800 + 4 * cb) / 4] = 0x00000001;         /* CBA2R: AArch64 */
+	gr1[cb] = 0x0001f000;                           /* CBAR */
+	cbp[0] = 0x000000e0;                            /* SCTLR last: fault reporting, M=0 */
+	gr0[(0xc00 + 4 * slot) / 4] = (uint32_t)cb;     /* S2CR: translate via the bank */
+	gr0[(0x800 + 4 * slot) / 4] = (1u << 31) | USB_SID;
+	gr0[0x70 / 4] = 0;                              /* sTLBGSYNC */
+	for (int i = 0; i < 1000 && (gr0[0x74 / 4] & 1); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: SMMU stream 0x%x -> CB%d via SMR%d: SMR 0x%08x S2CR 0x%08x\n", USB_SID, cb, slot,
+	    gr0[(0x800 + 4 * slot) / 4], gr0[(0xc00 + 4 * slot) / 4]);
+}
+
+/* Console over the bulk IN endpoint. Nothing here may print while it works. */
+static void
+ud_acm_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t pos = 0;       /* from the start of the ring: the boot is what we want */
+
+	for (;;) {
+		if (!ud.configured) {
+			ud_sleep_ms(50);
+			continue;
+		}
+		lck_mtx_lock(ud.lock);
+		if (ud.tx_busy) {
+			lck_mtx_unlock(ud.lock);
+			ud_sleep_ms(2);
+			continue;
+		}
+		uint32_t n = sweet_log_copy(&pos, (char *)(ud.dma + UD_TX), 2047);
+		if (n == 0) {
+			lck_mtx_unlock(ud.lock);
+			ud_sleep_ms(50);
+			continue;
+		}
+		if ((n % 512) == 0) {   /* a short packet ends the transfer without a ZLP */
+			n--;
+			pos--;
+		}
+		ud.tx_busy = true;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
+		lck_mtx_unlock(ud.lock);
+	}
+}
