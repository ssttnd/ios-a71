+int sweet_rpmh_usb_rails(void);
+int
+sweet_rpmh_usb_rails(void)
+{
+	static const struct {
+		const char *res;
+		unsigned    mv;
+	} rail[] = { { "ldoa4", 880 }, { "ldoa11", 1800 }, { "ldoa17", 3075 } };
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	if (!rh_poisoned) {
+		error = rh_map();
+		for (unsigned i = 0; !error && i < sizeof(rail) / sizeof(rail[0]); i++) {
+			uint32_t address = 0;
+			error = rh_lookup(rail[i].res, &address);
+			if (!error) {
+				error = rh_send(address, rail[i].mv);
+			}
+			printf("SWEET RPMH: USB rail %s %u mV -> %d\n", rail[i].res, rail[i].mv, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
