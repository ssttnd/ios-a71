--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -783,9 +783,14 @@
 {
     int enabled=0;
     char name[32]={0};proc_selfname(name,sizeof(name));
-    if (call!=0x5a || !PE_parse_boot_argn("sweetgles",&enabled,sizeof(enabled)) ||
-        enabled!=1 || strcmp(name,"backboardd")) return ENOPOLICY;
-    uint64_t request[2], flags=0x7b;
+    if (call!=0x5a) return ENOPOLICY;
+    /* 0206: with no answer dyld treats every process as restricted and will not expand @rpath, so apps
+       that keep frameworks inside their bundle die at launch: Music (MusicApplication), Podcasts
+       (NowPlayingUI), Books (BKAudiobooks, BookCore). An ordinary iPhone allows @ paths and fallback
+       paths (AMFI_DYLD_OUTPUT_ALLOW_AT_PATH | _ALLOW_FALLBACK_PATHS). The GLES experiment keeps its set. */
+    uint64_t request[2], flags=0x9;
+    if (PE_parse_boot_argn("sweetgles",&enabled,sizeof(enabled)) && enabled==1 && !strcmp(name,"backboardd"))
+        flags=0x7b;
     if (copyin(arg,request,sizeof(request)) || !request[1]) return EFAULT;
     return copyout(&flags,(user_addr_t)request[1],sizeof(flags));
 }
