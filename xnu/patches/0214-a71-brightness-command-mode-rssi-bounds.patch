+/* 0214: DCS short write with one parameter (data id 0x15), once: 53 20 turns brightness control on (DT gamma_mode2_tx_cmds). */
+static void
+sweet_bl_write_control(volatile uint32_t *dsi)
+{
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4], dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	const uint32_t word = 0x53u | (0x20u << 8) | (0x15u << 16) | (0x80u << 24);
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = word;
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30))) | (1u << 26) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = sizeof(word);
+	__asm__ volatile("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	IOLog("SWEET BL: DCS 53 20 %s after %u us ack_err=%#x\n", done ? "sent" : "NOT acknowledged", us, dsi[DSI_REG_ACK_ERR / 4]);
+}
